# ==============================================================================
# Cruise Management System - Global Infrastructure Configuration Template
# Copy this file to .env before starting the infrastructure stack:
#   make init  (Linux/macOS)  OR  .\manage.ps1 init  (Windows)
# This will automatically create .env (mode 0600) with generated unique passwords.
# ==============================================================================

# --- [COMPOSE PROJECT] ---
COMPOSE_PROJECT_NAME=cruise-fleet

# --- [DATABASE: PostgreSQL Primary] ---
POSTGRES_DB=cruise_db
POSTGRES_USER=cruise_admin
POSTGRES_PASSWORD=cruise_secret_password_change_me
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1

# --- [DATABASE: PostgreSQL Standby / HA] ---
POSTGRES_REPL_USER=replicator
POSTGRES_REPL_PASSWORD=repl_secret_password_change_me
POSTGRES_STANDBY_PORT=5433

# --- [CACHE: Redis In-Memory Store] ---
REDIS_PORT=6379
REDIS_HOST_BIND=127.0.0.1
REDIS_PASSWORD=redis_secret_password_change_me
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- [BACKEND APIS & SERVICES] ---
API_GATEWAY_PORT=8080
API_AUTH_PORT=8081
API_ACTIVITY_PORT=8082
API_ITINERARY_PORT=8083
API_POS_PORT=8084

# --- [FRONTEND CLIENTS] ---
WEB_PORT=3000
POS_CLIENT_PORT=3001

# --- [REVERSE PROXY & GATEWAY] ---
HTTP_PORT=80
HTTPS_PORT=443

# --- [MONITORING & OBSERVABILITY] ---
# Prometheus & Grafana credentials
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_password_change_me

# --- [JWT & SECURITY TOKENS] ---
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_for_hs256_algorithm
JWT_EXPIRATION_MS=86400000
